# Build Configuration for Gibbon Education Platform
# This file defines the Docker image configuration for building Gibbon

# Application image name (used for tagging in registry)
APP_IMAGE="gibbon"

# Database image name (used for tagging in registry)
MYSQL_IMAGE="gibbon-mysql"

# Human-readable database name (used in display messages)
MYSQL_NAME="MySQL"

# AI Studio side-container, layered on the stock ai-studio image
# (apps/ai-studio/ — must be built first) with the runtime binaries the
# Gibbon DevOps Skill shells out to (default-mysql-client, openssh-client,
# sshpass). The skill payload itself is delivered at container start via
# AI_STUDIO_SKILLS=https://github.com/Clouve/magneto-skills.git?plugins=gibbon
# — set on the ai-studio service in docker-compose.yml /
# clv-docker-compose.yml — which the upstream loader clones from the
# magneto-skills Claude Code marketplace at start.
AI_STUDIO_IMAGE="gibbon-ai-studio"
AI_STUDIO_NAME="AI Studio (Gibbon)"
