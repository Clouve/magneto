# Build Configuration for Gibbon Education Platform
# This file defines the Docker image configuration for building Gibbon

# Application image name (used for tagging in registry)
APP_IMAGE="gibbon"

# Database image name (used for tagging in registry)
MYSQL_IMAGE="gibbon-mysql"

# Human-readable database name (used in display messages)
MYSQL_NAME="MySQL"

# Note: this app does NOT ship its own Magneto Agent image. The compose files
# pull the upstream r.clv.zone/e2eorg/magneto-agent image directly. The runtime
# binaries the Gibbon DevOps Skill shells out to (mysql, mysqldump, ssh,
# sshpass) are installed at container start by the plugin's install.sh hook
# in the magneto-skills marketplace — see plugins/gibbon/install.sh in
# https://github.com/Clouve/magneto-skills.
