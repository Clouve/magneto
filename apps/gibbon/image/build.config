# Build Configuration for Gibbon Education Platform
# This file defines the Docker image configuration for building Gibbon

# Application image name (used for tagging in registry)
APP_IMAGE="gibbon"

# Database image name (used for tagging in registry)
MYSQL_IMAGE="gibbon-mysql"

# Human-readable database name (used in display messages)
MYSQL_NAME="MySQL"

# AI Studio side-container, pre-bundled with the Gibbon DevOps Skill, the
# /etc/profile.d/ symlink drop-in, and a Gibbon-flavoured CLAUDE.md.tpl.
# Built FROM the stock ai-studio image (apps/ai-studio/) — that one must be
# built first.
AI_STUDIO_IMAGE="gibbon-ai-studio"
AI_STUDIO_NAME="AI Studio (Gibbon)"

# Override the default sub-container build context. By default build.sh
# uses the container's own subdirectory (image/ai-studio/) as the docker
# context, but the Gibbon AI Studio Dockerfile needs to COPY assets from
# outside that subdirectory (skill/ and image/profile.d/), so the context
# is set to the app root. Path is relative to the app directory.
AI_STUDIO_CONTEXT="."
